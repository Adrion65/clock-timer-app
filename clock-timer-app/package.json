{
  "name": "clock-timer",
  "version": "1.14.0",
  "description": "Pop-out clock and timer windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.example.clocktimer",
    "productName": "Clock & Timer",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "fonts/**/*"
    ],
    "mac": {
      "target": "zip",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "portable",
      "artifactName": "Clock-Timer-1.14.w.exe"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Clock & Timer <noreply@example.com>",
      "synopsis": "Clock and timer",
      "artifactName": "Clock-Timer-1.14.l-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com",
  "author": "Clock & Timer <noreply@example.com>"
}